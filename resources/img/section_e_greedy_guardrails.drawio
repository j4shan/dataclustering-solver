    </mxCell>
    <mxCell id="n169" value="&lt;font style=&quot;font-size:12.5px;color:#52514E&quot;&gt;Keep every container worth opening. K&lt;sub&gt;max&lt;/sub&gt; = ⌊n / s&lt;sub&gt;min&lt;/sub&gt;⌋ = 20 closes the chain from above.&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1">
