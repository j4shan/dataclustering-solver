      <mxGeometry x="56.0" y="894.0" width="560.0" height="26.0" as="geometry" />
    </mxCell>
    <mxCell id="n162" value="&lt;font style=&quot;font-size:12.5px;color:#52514E&quot;&gt;Refuse the rising half. The first count that survives is K = 11; below it the chain is convex.&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1">
