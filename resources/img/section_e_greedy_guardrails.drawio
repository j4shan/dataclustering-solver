    <mxCell id="n160" value="&lt;font style=&quot;font-size:14.5px;color:#0B0B0B&quot;&gt;&lt;b&gt;starting count&lt;/b&gt;&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1">
