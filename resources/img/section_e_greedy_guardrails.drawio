    </mxCell>
    <mxCell id="n153" value="&lt;font style=&quot;font-size:12.5px;color:#0B0B0B&quot;&gt;incremental volume decreases&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1">
      <mxGeometry x="1650.0" y="650.0" width="212.0" height="30.0" as="geometry" />
    </mxCell>
    <mxCell id="n154" value="&lt;font style=&quot;font-size:12.5px;color:#0B0B0B&quot;&gt;Greedy takes the best exposed step first. That works on the decaying half. On the rising half a later step beats the one in front of it.&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1">
      <mxGeometry x="1488.0" y="692.0" width="374.0" height="56.0" as="geometry" />
