    <mxCell id="n141" value="&lt;font face=&quot;Menlo, ui-monospace, monospace&quot; style=&quot;font-size:14px;color:#0B0B0B&quot;&gt;V(K) = n · e&lt;sup&gt;−np/K&lt;/sup&gt;&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1">
      <mxGeometry x="1488.0" y="260.0" width="374.0" height="30.0" as="geometry" />
