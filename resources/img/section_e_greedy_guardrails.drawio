      <mxGeometry x="1488.0" y="304.0" width="374.0" height="22.0" as="geometry" />
    </mxCell>
    <mxCell id="n143" value="&lt;span style=&quot;display:inline-block;vertical-align:middle;text-align:center;font-family:Menlo, ui-monospace, monospace;font-size:14px;color:#0B0B0B&quot;&gt;&lt;span style=&quot;display:block;border-bottom:1px solid #0B0B0B;padding:0 4px&quot;&gt;ΔV&lt;/span&gt;&lt;span style=&quot;display:block;padding:0 4px&quot;&gt;ΔK&lt;/span&gt;&lt;/span&gt;&lt;span style=&quot;display:inline-block;vertical-align:middle;font-family:Menlo, ui-monospace, monospace;font-size:14px;color:#0B0B0B&quot;&gt;&amp;#160;= V(K + 1) − V(K)&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1">
      <mxGeometry x="1488.0" y="334.0" width="374.0" height="46.0" as="geometry" />
    </mxCell>
    <mxCell id="n144" value="&lt;font style=&quot;font-size:12px;color:#52514E&quot;&gt;one step of the chain, so ΔK = 1&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1">
      <mxGeometry x="1488.0" y="386.0" width="374.0" height="20.0" as="geometry" />
    </mxCell>
    <mxCell id="n145" value="&lt;font style=&quot;font-size:13.5px;color:#0B0B0B&quot;&gt;&lt;b&gt;concavity&lt;/b&gt;&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1">
      <mxGeometry x="1488.0" y="420.0" width="374.0" height="22.0" as="geometry" />
    </mxCell>
    <mxCell id="n146" value="&lt;span style=&quot;display:inline-block;vertical-align:middle;text-align:center;font-family:Menlo, ui-monospace, monospace;font-size:14px;color:#0B0B0B&quot;&gt;&lt;span style=&quot;display:block;border-bottom:1px solid #0B0B0B;padding:0 4px&quot;&gt;d²V&lt;/span&gt;&lt;span style=&quot;display:block;padding:0 4px&quot;&gt;dK²&lt;/span&gt;&lt;/span&gt;&lt;span style=&quot;display:inline-block;vertical-align:middle;font-family:Menlo, ui-monospace, monospace;font-size:14px;color:#0B0B0B&quot;&gt;&amp;#160;= V(K) ·&lt;/span&gt;&lt;span style=&quot;display:inline-block;vertical-align:middle;text-align:center;font-family:Menlo, ui-monospace, monospace;font-size:14px;color:#0B0B0B&quot;&gt;&lt;span style=&quot;display:block;border-bottom:1px solid #0B0B0B;padding:0 4px&quot;&gt;np&lt;/span&gt;&lt;span style=&quot;display:block;padding:0 4px&quot;&gt;K³&lt;/span&gt;&lt;/span&gt;&lt;span style=&quot;display:inline-block;vertical-align:middle;font-family:Menlo, ui-monospace, monospace;font-size:14px;color:#0B0B0B&quot;&gt;&amp;#160;· ( np / K − 2 )&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1">
      <mxGeometry x="1488.0" y="450.0" width="374.0" height="46.0" as="geometry" />
    </mxCell>
    <mxCell id="n147" value="&lt;font style=&quot;font-size:12.5px;color:#52514E&quot;&gt;Only the bracket can turn negative. The sign flips where np / K = 2, which puts the inflection at K&lt;sub&gt;0&lt;/sub&gt; = np / 2 = 10.5.&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1">
      <mxGeometry x="1488.0" y="504.0" width="374.0" height="54.0" as="geometry" />
